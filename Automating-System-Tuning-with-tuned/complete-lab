Task 3: Verify Performance Improvements with Benchmarking Scripts
Subtask 3.1: Creating a Performance Snapshot Script
Create a system snapshot script:
cat > ~/performance_analyzer.sh << 'EOF'
#!/bin/bash

# Comprehensive System Performance Analyzer
# Usage: ./performance_analyzer.sh [profile_name]

PROFILE_NAME=${1:-"current"}
OUTPUT_DIR="/tmp/performance_analysis"
TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
REPORT_FILE="$OUTPUT_DIR/performance_report_${PROFILE_NAME}_${TIMESTAMP}.txt"

mkdir -p $OUTPUT_DIR

echo "=== System Performance Analysis Report ===" > $REPORT_FILE
echo "Profile: $PROFILE_NAME" >> $REPORT_FILE
echo "Timestamp: $(date)" >> $REPORT_FILE
echo "Hostname: $(hostname)" >> $REPORT_FILE
echo "" >> $REPORT_FILE

echo "=== Active tuned Profile ===" >> $REPORT_FILE
tuned-adm active >> $REPORT_FILE 2>&1
echo "" >> $REPORT_FILE

echo "=== CPU Information ===" >> $REPORT_FILE
lscpu | grep -E "CPU\(s\)|Thread|Core|Socket|Model name" >> $REPORT_FILE
echo "" >> $REPORT_FILE

echo "=== Memory Information ===" >> $REPORT_FILE
free -h >> $REPORT_FILE
echo "" >> $REPORT_FILE

echo "=== Critical Kernel Parameters ===" >> $REPORT_FILE
sysctl vm.swappiness vm.dirty_ratio vm.dirty_background_ratio >> $REPORT_FILE 2>&1
sysctl net.core.rmem_max net.core.wmem_max >> $REPORT_FILE 2>&1
sysctl fs.file-max >> $REPORT_FILE 2>&1
echo "" >> $REPORT_FILE

echo "=== CPU Governor ===" >> $REPORT_FILE
cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null >> $REPORT_FILE || echo "N/A" >> $REPORT_FILE
echo "" >> $REPORT_FILE

echo "=== System Load ===" >> $REPORT_FILE
uptime >> $REPORT_FILE
echo "" >> $REPORT_FILE

echo "Performance analysis completed. Report saved to: $REPORT_FILE"
EOF

chmod +x ~/performance_analyzer.sh
Run the snapshot script under the balanced profile as a control:
sudo tuned-adm profile balanced
sleep 3
~/performance_analyzer.sh balanced
Subtask 3.2: Running a CPU Benchmark Across Profiles
Create the CPU benchmark script:
cat > ~/cpu_benchmark.sh << 'EOF'
#!/bin/bash

# CPU Performance Benchmark Script
# Tests CPU performance under the currently active tuned profile

BENCHMARK_DIR="/tmp/cpu_benchmarks"
TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
PROFILE_NAME=$(tuned-adm active | sed 's/Current active profile: //')

mkdir -p $BENCHMARK_DIR

echo "=== CPU Benchmark Test ==="
echo "Profile: $PROFILE_NAME"
echo "Start time: $(date)"

RESULT_FILE="$BENCHMARK_DIR/cpu_benchmark_${PROFILE_NAME}_${TIMESTAMP}.txt"

python3 - "$RESULT_FILE" "$PROFILE_NAME" << 'PYEOF'
import sys
import time

result_file = sys.argv[1]
profile_name = sys.argv[2]


def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n ** 0.5) + 1):
        if n % i == 0:
            return False
    return True


def run_prime_benchmark(limit):
    start = time.time()
    primes = [n for n in range(2, limit) if is_prime(n)]
    elapsed = time.time() - start
    return len(primes), elapsed


count, elapsed = run_prime_benchmark(200000)

with open(result_file, "w") as f:
    f.write("=== CPU Benchmark Result ===\n")
    f.write(f"Profile: {profile_name}\n")
    f.write(f"Primes found below 200000: {count}\n")
    f.write(f"Elapsed time (seconds): {elapsed:.4f}\n")

print(f"Profile: {profile_name}")
print(f"Found {count} primes in {elapsed:.4f} seconds")
print(f"Result saved to {result_file}")
PYEOF

echo "End time: $(date)"
EOF

chmod +x ~/cpu_benchmark.sh
